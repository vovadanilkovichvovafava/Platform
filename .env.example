# ============================================================================
# R&D Academy — environment variables
# Copy to .env and fill in. See SATURN_MIGRATION.md for the migration runbook.
# ============================================================================

# ─── Database (REQUIRED) ────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance. Self-hosted inside the perimeter for Saturn.
#   DATABASE_URL — connection used by the app (may point at a pooler)
#   DIRECT_URL   — direct, non-pooled connection used for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rnd_academy"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/rnd_academy"

# Schema handling on boot: deploy | push | none
#   deploy — apply prisma/migrations. REQUIRED for production/Saturn.
#   push   — sync straight from schema.prisma, ignores migration history (legacy).
#   none   — skip; migrations run as a separate job.
DB_MIGRATE_MODE="deploy"

# ─── Auth (REQUIRED) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-a-real-secret"
# Full public origin of the app, no trailing slash.
NEXTAUTH_URL="https://academy.example.internal"

# Listen port (default 8080)
PORT="8080"

# ─── Seeding ────────────────────────────────────────────────────────────────
# 'true' re-runs prisma/seed.ts on every boot. NEVER enable against real data.
FORCE_SEED="false"
# 'true' seeds even when the database could not be read. Unsafe — leave false.
ALLOW_SEED_ON_ERROR="false"

# ============================================================================
# OPTIONAL INTEGRATIONS — each requires outbound network access.
# In a closed network, leave disabled unless the host is whitelisted.
# ============================================================================

# ─── AI content import + AI submission review ───────────────────────────────
# Outbound: api.anthropic.com (or your internal LLM gateway)
AI_PARSER_ENABLED="false"
AI_SUBMISSION_REVIEW_ENABLED="false"
AI_API_KEY=""
# Alternative variable name honoured for compatibility
# ANTHROPIC_API_KEY=""
AI_API_ENDPOINT="https://api.anthropic.com/v1/messages"
AI_MODEL="claude-sonnet-4-5-20241022"
AI_CHECK_TIMEOUT_MS="15000"     # API availability probe (15 s)
AI_PARSE_TIMEOUT_MS="900000"    # Content parsing (15 min for large documents)
AI_MAX_CONTENT_CHARS="100000"   # Max input size in characters
AI_MAX_OUTPUT_TOKENS=""         # Optional cap on response length
AI_DEBUG="false"

# ─── Telegram notifications ─────────────────────────────────────────────────
# Outbound: api.telegram.org. Also requires a PUBLIC inbound URL for the
# webhook (/api/telegram/webhook) — usually unavailable in a closed network.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Generate: openssl rand -base64 32 — verifies X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""

# ─── External HR analytics API (/api/external/*) ────────────────────────────
# Shared bearer secret for inbound integration requests.
# Generate: openssl rand -base64 32
COMMUNICATION_API_KEY=""
